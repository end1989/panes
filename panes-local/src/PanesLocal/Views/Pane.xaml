<UserControl x:Class="PanesLocal.Views.Pane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="#000000"
             AllowDrop="True"
             ClipToBounds="True"
             Focusable="False">
    <Grid>
        <vlc:VideoView x:Name="VlcView" Visibility="Collapsed" Focusable="False" IsHitTestVisible="False" />

        <!-- Per-pane controls moved to SidePanel's "Now Playing" section.
             WPF buttons can't render over libVLC's HwndHost video surface
             — the native window overdraws everything. The hover overlay
             code remains in Pane.xaml.cs for the drag-to-swap behavior but
             nothing is wired to MuteBtn/SkipBtn/StopBtn anymore. -->
        <Grid x:Name="HoverOverlay" Visibility="Collapsed">
            <Button x:Name="MuteBtn" Click="MuteBtn_Click"/>
            <Button x:Name="SkipBtn" Click="SkipBtn_Click"/>
            <Button x:Name="StopBtn" Click="StopBtn_Click"/>
        </Grid>

        <Border x:Name="DragHighlight"
                BorderBrush="#FF4FC3F7"
                BorderThickness="3"
                Visibility="Collapsed"/>

        <TextBlock x:Name="EmptyHint"
                   Text="(queue empty)"
                   Foreground="#666666"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
